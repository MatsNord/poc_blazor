@inherits LayoutComponentBase

<header class="app-bar">
    <a class="app-bar__brand" href="/">Vuetify &rarr; Blazor</a>
    <nav class="app-bar__nav" aria-label="Main">
        <NavLink class="app-bar__link" href="" Match="NavLinkMatch.All">Todo</NavLink>
        <NavLink class="app-bar__link" href="components">Components</NavLink>
    </nav>
</header>

<main class="app-main">
    @Body
</main>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
