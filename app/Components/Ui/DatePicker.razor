@namespace app.Components.Ui
@using System.Globalization
@inject IJSRuntime JS
@* Date picker with calendar popup, month navigation, selection and clearing.
   Translated from Vuetify's VDatePicker (+ VDatePickerControls/Month). *@

<div class="dp @StateClasses">
    <div class="dp__field">
        <button id="@_triggerId"
                type="button"
                class="dp__trigger"
                aria-haspopup="dialog"
                aria-expanded="@(_open ? "true" : "false")"
                @onclick="ToggleAsync"
                @ref="_trigger">
            @* The label sits permanently on the top border, so the placeholder is
               always visible when no date is selected. *@
            <span class="dp__value @(Value is null ? "dp__value--empty" : null)">
                @(Value?.ToString("d", CultureInfo.CurrentCulture) ?? Placeholder)
            </span>
            <svg class="dp__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1" />
            </svg>
        </button>
        @if (!string.IsNullOrEmpty(Label))
        {
            @* Static label notched into the top border (matches TextField's label). *@
            <label class="dp__label" for="@_triggerId">@Label</label>
        }
    </div>

    @if (_open)
    {
        @* Transparent layer that closes the popup on outside click (no JS). *@
        <div class="dp__backdrop" @onclick="() => CloseAsync(false)"></div>

        <div class="dp__popup"
             role="dialog"
             aria-label="@(Label ?? "Choose date")"
             @onkeydown="OnPopupKeyDownAsync">
            <div class="dp__controls">
                <button type="button" class="dp__nav" aria-label="Previous month" @onclick="() => ShiftMonth(-1)">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" />
                    </svg>
                </button>
                <span class="dp__month" aria-live="polite">
                    @_displayMonth.ToString("MMMM yyyy", CultureInfo.CurrentCulture)
                </span>
                <button type="button" class="dp__nav" aria-label="Next month" @onclick="() => ShiftMonth(1)">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" />
                    </svg>
                </button>
            </div>

            <div class="dp__weekdays">
                @foreach (var name in WeekdayNames)
                {
                    <span class="dp__weekday">@name</span>
                }
            </div>

            <div class="dp__grid" role="grid"
                 aria-label="@_displayMonth.ToString("MMMM yyyy", CultureInfo.CurrentCulture)">
                @foreach (var day in Days)
                {
                    var d = day;
                    <button type="button"
                            id="@DayId(d)"
                            class="dp__day @DayClass(d)"
                            @key="d"
                            aria-label="@d.ToString("D", CultureInfo.CurrentCulture)"
                            aria-pressed="@(d == Value ? "true" : "false")"
                            @onclick="() => SelectDayAsync(d)"
                            @onfocus="() => _focusedDay = d">@d.Day</button>
                }
            </div>

            <div class="dp__actions">
                <FlatButton Color="error" OnClick="ClearAsync">Clear</FlatButton>
            </div>
        </div>
    }
</div>

@code {
    private readonly string _triggerId = $"dp-{Guid.NewGuid():N}";
    private ElementReference _trigger;
    private bool _open;
    private DateOnly _displayMonth;
    private DateOnly? _focusedDay;
    private DateOnly? _pendingFocusDay;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    [Parameter] public string? Label { get; set; }

    [Parameter] public string Placeholder { get; set; } = "Select date";

    [Parameter] public DateOnly? Value { get; set; }

    [Parameter] public EventCallback<DateOnly?> ValueChanged { get; set; }

    private bool HasValue => Value is not null;

    private string StateClasses => string.Join(' ', new[]
    {
        _open ? "dp--open" : null,
        HasValue ? "dp--active" : null,
    }.Where(c => c is not null));

    private static DayOfWeek FirstDayOfWeek => CultureInfo.CurrentCulture.DateTimeFormat.FirstDayOfWeek;

    private IEnumerable<string> WeekdayNames => Enumerable.Range(0, 7)
        .Select(i => CultureInfo.CurrentCulture.DateTimeFormat.AbbreviatedDayNames[((int)FirstDayOfWeek + i) % 7]);

    /// <summary>42 visible cells (6 weeks) covering the displayed month.</summary>
    private IReadOnlyList<DateOnly> Days
    {
        get
        {
            var first = new DateOnly(_displayMonth.Year, _displayMonth.Month, 1);
            var offset = ((int)first.DayOfWeek - (int)FirstDayOfWeek + 7) % 7;
            var start = first.AddDays(-offset);
            return Enumerable.Range(0, 42).Select(start.AddDays).ToList();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_open && _pendingFocusDay is { } day)
        {
            _pendingFocusDay = null;
            await JS.InvokeVoidAsync("datePickerFocus", DayId(day));
        }
    }

    private string DayId(DateOnly day) => $"{_triggerId}-day-{day:yyyy-MM-dd}";

    private async Task ToggleAsync()
    {
        if (_open)
        {
            await CloseAsync(restoreFocus: false);
            return;
        }

        _open = true;
        _displayMonth = FirstOfMonth(Value ?? Today);
        _focusedDay = Value ?? Today;
        _pendingFocusDay = _focusedDay;
    }

    private void ShiftMonth(int months)
    {
        _displayMonth = FirstOfMonth(_displayMonth.AddMonths(months));
    }

    private async Task SelectDayAsync(DateOnly day)
    {
        Value = day;
        await ValueChanged.InvokeAsync(Value);
        await CloseAsync(restoreFocus: true);
    }

    private async Task ClearAsync()
    {
        Value = null;
        await ValueChanged.InvokeAsync(Value);
        await CloseAsync(restoreFocus: true);
    }

    private async Task OnPopupKeyDownAsync(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape":
                // Close and give focus back to the trigger button.
                await CloseAsync(restoreFocus: true);
                break;
            case "ArrowLeft":
                MoveFocus(-1);
                break;
            case "ArrowRight":
                MoveFocus(1);
                break;
            case "ArrowUp":
                MoveFocus(-7);
                break;
            case "ArrowDown":
                MoveFocus(7);
                break;
        }
    }

    private void MoveFocus(int deltaDays)
    {
        if (_focusedDay is not { } current) return;

        var next = current.AddDays(deltaDays);
        if (next.Month != _displayMonth.Month)
        {
            _displayMonth = FirstOfMonth(next);
        }

        _focusedDay = next;
        _pendingFocusDay = next;
    }

    private async Task CloseAsync(bool restoreFocus)
    {
        _open = false;
        _focusedDay = null;
        _pendingFocusDay = null;
        if (restoreFocus)
        {
            await _trigger.FocusAsync();
        }
    }

    private static DateOnly FirstOfMonth(DateOnly d) => new(d.Year, d.Month, 1);

    private string DayClass(DateOnly day)
    {
        var classes = new List<string>(3);
        if (day.Month != _displayMonth.Month) classes.Add("dp__day--outside");
        if (day == Today) classes.Add("dp__day--today");
        if (day == Value) classes.Add("dp__day--selected");
        return string.Join(' ', classes);
    }
}
